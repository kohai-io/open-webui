[Unit]
Description=Open WebUI Studio pinned OCI deployment
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/open-webui-studio/compose.yaml
ConditionPathExists=/etc/open-webui-studio/deployment.env
ConditionPathExists=/etc/open-webui-studio/runtime.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/open-webui-studio
ExecStartPre=/usr/local/lib/owui-deploy/validate-deployment.sh studio
ExecStart=/usr/bin/docker compose --env-file /etc/open-webui-studio/deployment.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /etc/open-webui-studio/deployment.env stop
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
